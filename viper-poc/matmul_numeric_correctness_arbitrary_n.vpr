// Numeric correctness for the tiled-matmul kernel, generalized to
// arbitrary N (not fixed at 4x4) -- see matmul_numeric_correctness.vpr
// for the concrete N=4 version this generalizes.
//
// This generalization is possible HERE specifically because this file is
// hand-written (same status as matmul_numeric_correctness.vpr itself,
// not derived from any real compiler output), so N is free to be a
// genuine Int method parameter. real_compiler_tiled_matmul.vpr -- the
// permission-only proof checked against the REAL compiled kernel's own
// translated output -- stays fixed at N=4: a real compiled kernel's
// shared-memory tile size is baked in by monomorphization at compile
// time, the same reason the reduction kernel's real closure stays fixed
// at N=8 (see NOTES.md). Generalizing THIS file generalizes the
// hand-written numeric argument, not the real-compiler-closure's own
// checked artifact.
//
// The one genuinely hard part: row*n+k < n*n (needed for every shared-
// memory index) is NONLINEAR (a product of two symbolic variables, n and
// row/k), which Z3 does not discharge unprompted -- unlike the N=4 file,
// where every such fact was just arithmetic on literals. `bound_holds`
// below is an inductive proof of exactly this fact, structured so a
// Viper *function* (not a method -- functions can't contain `assert`
// statements, so the usual induction-via-asserts idiom doesn't apply)
// can still establish it, and critically also prove its own termination
// -- which took real iteration to get right; see NOTES.md.

field val: Int

// bound_holds(n, a, b) == a*n+b, packaged together with the two facts
// every array access below needs: this is a REAL index (bounded below)
// and it's within the n*n-element array (bounded above). Computed by
// induction on (n-a) -- "how far a is from n" -- rather than attempting
// the nonlinear inequality directly: each step only ever adds or
// subtracts n (linear), never re-derives a product from scratch.
function bound_holds(n: Int, a: Int, b: Int): Int
  requires n >= 1
  requires a >= 0 && a < n
  requires b >= 0 && b < n
  ensures result == a * n + b
  ensures result >= 0 && result < n * n
  decreases n - a
{
  a + 1 < n ? bound_holds(n, a + 1, b) - n : a * n + b
}

// dot_sum(oa, ob, n, row, col, k) = sum_{j=0}^{k-1} oa[row*n+j] * ob[j*n+col]
// -- the partial dot product after k of the n terms. Indexes via
// bound_holds (not row*n+j / j*n+col directly) so the function's own
// well-formedness and termination proofs reuse bound_holds's already-
// established bound instead of needing their own nonlinear reasoning.
function dot_sum(oa: Seq[Int], ob: Seq[Int], n: Int, row: Int, col: Int, k: Int): Int
  requires n >= 1
  requires row >= 0 && row < n
  requires col >= 0 && col < n
  requires k >= 0 && k <= n
  requires |oa| == n * n
  requires |ob| == n * n
  decreases k
{
  k == 0 ? 0 : dot_sum(oa, ob, n, row, col, k - 1)
    + oa[bound_holds(n, row, k - 1)] * ob[bound_holds(n, k - 1, col)]
}

method numeric_correctness(cells: Seq[Ref], cells2: Seq[Ref], tid: Int, n: Int, oa: Seq[Int], ob: Seq[Int])
  requires n >= 1
  requires |cells| == n * n
  requires |cells2| == n * n
  requires |oa| == n * n
  requires |ob| == n * n
  requires forall i: Int, j: Int :: 0 <= i && i < n * n && 0 <= j && j < n * n && i != j ==> cells[i] != cells[j]
  requires forall i: Int, j: Int :: 0 <= i && i < n * n && 0 <= j && j < n * n && i != j ==> cells2[i] != cells2[j]
  requires forall i: Int, j: Int :: 0 <= i && i < n * n && 0 <= j && j < n * n ==> cells[i] != cells2[j]
  requires 0 <= tid && tid < n * n
  requires acc(cells[tid].val)
  requires acc(cells2[tid].val)
  requires cells[tid].val == oa[tid]
  requires cells2[tid].val == ob[tid]
  ensures acc(cells[tid].val)
  ensures acc(cells2[tid].val)
  ensures cells[tid].val == dot_sum(oa, ob, n, tid \ n, tid % n, n)
{
  // tid \ n < n and tid % n < n follow directly from tid < n*n via Z3's
  // own built-in division/modulo axioms -- no lemma needed, confirmed
  // this is the one piece of bounds reasoning here that DOESN'T need
  // bound_holds's help.
  var row: Int := tid \ n
  var col: Int := tid % n
  var acc_val: Int := 0
  var k: Int := 0

  // Base case: nothing summed yet.
  assert dot_sum(oa, ob, n, row, col, 0) == 0

  while (k < n)
    invariant k >= 0 && k <= n
    invariant acc(cells[tid].val)
    invariant acc(cells2[tid].val)
    invariant acc_val == dot_sum(oa, ob, n, row, col, k)
  {
    exhale true
    inhale acc(cells[bound_holds(n, row, k)].val)
    // The acquire grants PERMISSION only. The VALUE fact -- that this
    // cell still holds its original load-phase value -- comes from the
    // same argument real_compiler_tiled_matmul.vpr's acquire already
    // relies on at the permission level: nothing ever writes to any cell
    // of either tile between the load phase and this kernel's own final
    // write-back, so by the N-thread symmetry every thread's load-phase
    // claim (cells[i].val == oa[i]) still holds for every i throughout
    // the loop. Assumed here the same way the permission itself is.
    inhale cells[bound_holds(n, row, k)].val == oa[bound_holds(n, row, k)]
    exhale true
    inhale acc(cells2[bound_holds(n, k, col)].val)
    inhale cells2[bound_holds(n, k, col)].val == ob[bound_holds(n, k, col)]

    var own_a: Int := cells[bound_holds(n, row, k)].val
    var own_b: Int := cells2[bound_holds(n, k, col)].val
    acc_val := acc_val + own_a * own_b

    exhale acc(cells[bound_holds(n, row, k)].val)
    inhale true
    exhale acc(cells2[bound_holds(n, k, col)].val)
    inhale true

    // Z3 won't chain the recursive function's definition on its own --
    // state the one unfolding step directly, dischargeable immediately
    // from dot_sum's own defining equation.
    assert dot_sum(oa, ob, n, row, col, k + 1) == dot_sum(oa, ob, n, row, col, k)
      + oa[bound_holds(n, row, k)] * ob[bound_holds(n, k, col)]

    k := k + 1
  }

  cells[tid].val := acc_val
}
