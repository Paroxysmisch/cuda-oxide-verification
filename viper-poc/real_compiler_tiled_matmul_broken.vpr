  var v68: Int
  var v69: Int
  var v70: Int
  var v71: Int
  var v72: Int
  var v73: Int
  var v74: Int
  v2 := tid_param  // tid's alloca slot, bridged from the method parameter
  v4 := tid_param \ 4  // row := tid / 4, in the skipped prefix
  v5 := tid_param % 4  // col := tid % 4, in the skipped prefix
  v19 := 0  // k's alloca slot: `let mut k = 0usize;` in the skipped prefix
  v21 := v19
  var v103: Int := 4
  var v104: Bool := v21 < v103
  v20 := v104
  var v105: Bool := !v20
  while (!(!(v19 < 4)))
    invariant (v19 <= 4)
    invariant (v19 >= 0)
    invariant (v4 < 4)
    invariant (v5 < 4)
    invariant acc(cells[v2].val)
    invariant acc(cells2[v2].val)
  {
    v23 := v19
    var v106: Int := 4
    var v107: Bool := v23 <= v106
    v22 := v107
    var v108: Int
    v25 := v19
    var v109: Int := 0
    var v110: Bool := v25 >= v109
    v24 := v110
    var v111: Int
    var v112: Int := 4
    var v113: Bool := v4 < v112
    v26 := v113
    var v114: Int
    var v115: Int := 4
    var v116: Bool := v5 < v115
    v27 := v116
    var v117: Int
    var v123: Int
    var v129: Int
    var v131: Int := 4
    var v132: Int := v4 * v131
    v38 := v132
    v39 := v19
    var v133: Int := v38 + v39
    v37 := v133
    exhale true
    inhale acc(cells[v37].val)
    var v138: Int
    v46 := v19
    var v140: Int := 4
    var v141: Int := v46 * v140
    v45 := v141
    var v142: Int := v45 + v5
    v44 := v142
    var v143: Int := 1
    var v144: Int := v44 + v143
    v43 := v144
    exhale true
    inhale acc(cells2[v43].val)
    var v149: Int
    v47 := v18
    v53 := v19
    var v151: Int := v38 + v53
    v52 := v151
    var v155: Int := cells[v52].val
    v49 := v155
    v60 := v19
    var v157: Int := 4
    var v158: Int := v60 * v157
    v59 := v158
    var v159: Int := v59 + v5
    v58 := v159
    var v160: Int := 1
    var v161: Int := v58 + v160
    v57 := v161
    var v165: Int := cells2[v57].val
    v54 := v165
    var v166: Int := v49 * v54
    v48 := v166
    var v167: Int := v47 + v48
    v18 := v167
    v65 := v19
    var v169: Int := v38 + v65
    v64 := v169
    exhale acc(cells[v64].val)
    inhale true
    var v174: Int
    v72 := v19
    var v176: Int := 4
    var v177: Int := v72 * v176
    v71 := v177
    var v178: Int := v71 + v5
    v70 := v178
    var v179: Int := 1
    var v180: Int := v70 + v179
    v69 := v180
    exhale acc(cells2[v69].val)
    inhale true
    var v185: Int
    var v186: Int := 1
    var v187: Int := v19 + v186
    v19 := v187
    // re-entering header (back edge): recompute its condition/invariants
    v21 := v19
    v103 := 4
    v104 := v21 < v103
    v20 := v104
    v105 := !v20
  }
  cells[v2].val := v18
