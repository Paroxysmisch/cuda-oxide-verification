// Phase 5, part 2: numeric correctness -- the reduction actually computes
// the sum of its input, not just "touches memory safely."
//
// Everything proven so far (real_compiler_block_reduce.vpr, and part 1's
// injectivity check) is about PERMISSIONS: who may touch what, never about
// VALUES. This file adds the missing kind of claim: thread 0 ends up
// holding the sum of all 8 original elements.
//
// The invariant, parameterized by the CURRENT value of `stride` at each
// loop-test (matching real_compiler_block_reduce.vpr's own `v9 <= 4`
// checkpoint exactly): letting
//   width(stride)  = stride == 0 ? 1 : 2 * stride
//   count(stride)  = 8 / width(stride)
// the claim is: for tid < width(stride), cells[tid].val already holds the
// sum of `count(stride)` original elements spaced `width(stride)` apart
// starting at `tid` -- a "strided sum". `width`'s `stride == 0` case is
// the loop's exit state (after the stride=1 round): width collapses to 1,
// count to 8, giving exactly "cells[0] holds the sum of all 8 elements"
// as the ensures clause, with no special-cased exit logic needed -- the
// same single formula covers every checkpoint, including the last one.
//
// Maintaining this across one iteration (tid < stride, the guarded
// combine) needs a real inductive fact Z3 won't discover unprompted:
// merging two interleaved width-wide strided sums into one double-width
// strided sum. `merge_lemma` is that fact, proved by induction on the
// count (the two sums' terms interleave into exactly the double-width
// sum's terms, in a different order; addition doesn't care about order).

field val: Int

function strided_sum(o: Seq[Int], i: Int, s: Int, c: Int): Int
  requires s >= 1
  requires c >= 0
  requires i >= 0
  // The last term accessed is o[i + (c-1)*s], not o[i + c*s] -- there are
  // c terms starting AT i, so only c-1 strides happen after the first.
  requires c == 0 || i + (c - 1) * s < |o|
  decreases c
{
  c == 0 ? 0 : o[i] + strided_sum(o, i + s, s, c - 1)
}

// strided_sum(o,i,2s,c) sums o[i], o[i+2s], o[i+4s], ..., o[i+2s(c-1)]
// (c terms). strided_sum(o,i+s,2s,c) sums o[i+s], o[i+3s], ..., o[i+s(2c-1)]
// (c terms). Interleaved, that's exactly o[i], o[i+s], o[i+2s], ...,
// o[i+s(2c-1)] -- the 2c terms of strided_sum(o,i,s,2c), just reordered.
method merge_lemma(o: Seq[Int], i: Int, s: Int, c: Int)
  requires s >= 1
  requires c >= 0
  requires i >= 0
  requires c == 0 || i + (2 * c - 1) * s < |o|
  ensures strided_sum(o, i, 2 * s, c) + strided_sum(o, i + s, 2 * s, c) == strided_sum(o, i, s, 2 * c)
  decreases c
{
  if (c > 0) {
    merge_lemma(o, i + 2 * s, s, c - 1)
    // Z3 won't chain several levels of a recursive function's definition
    // on its own -- each of these states one unfolding directly, as its
    // own goal, which the function's defining equation discharges
    // immediately. Together with the recursive call's postcondition
    // above, they connect every term needed: unfold both sides of the
    // target equation down to the point where the recursive call's own
    // fact already closes the gap.
    assert strided_sum(o, i, 2 * s, c) == o[i] + strided_sum(o, i + 2 * s, 2 * s, c - 1)
    assert strided_sum(o, i + s, 2 * s, c) == o[i + s] + strided_sum(o, i + 3 * s, 2 * s, c - 1)
    assert strided_sum(o, i, s, 2 * c) == o[i] + strided_sum(o, i + s, s, 2 * c - 1)
    assert strided_sum(o, i + s, s, 2 * c - 1) == o[i + s] + strided_sum(o, i + 2 * s, s, 2 * c - 2)
  }
}

method numeric_correctness(cells: Seq[Ref], tid: Int, orig: Seq[Int])
  requires |cells| == 8
  requires |orig| == 8
  requires forall i: Int, j: Int :: 0 <= i && i < 8 && 0 <= j && j < 8 && i != j ==> cells[i] != cells[j]
  requires 0 <= tid && tid < 8
  requires acc(cells[tid].val)
  requires cells[tid].val == orig[tid]
  ensures acc(cells[tid].val)
  ensures tid == 0 ==> cells[0].val == strided_sum(orig, 0, 1, 8)
{
  var stride: Int
  stride := 4
  // Same reasoning as inside merge_lemma: force the one unfolding needed
  // to see that strided_sum(orig, tid, 8, 1) is just orig[tid] -- the
  // invariant's base case (nothing combined yet).
  assert strided_sum(orig, tid, 8, 1) == orig[tid] + strided_sum(orig, tid + 8, 8, 0)
  while (stride >= 1)
    invariant stride >= 0 && stride <= 4
    // stride only ever takes these three values on the way down from 4
    // to 0 -- needed, not just tidy: at stride=3 (which "1 <= stride <=
    // 4" alone doesn't rule out), stride/2 truncates to 1, and
    // 2*1 != 3 -- the halving arithmetic below genuinely depends on
    // stride being a power of two, not merely bounded.
    invariant stride == 4 || stride == 2 || stride == 1 || stride == 0
    invariant acc(cells[tid].val)
    invariant tid < (stride == 0 ? 1 : 2 * stride) ==>
      cells[tid].val == strided_sum(orig, tid, (stride == 0 ? 1 : 2 * stride), 8 / (stride == 0 ? 1 : 2 * stride))
  {
    if (tid < stride) {
      var own: Int := cells[tid].val
      // Spell out what the OLD invariant already says about `own`
      // (tid < stride <= 2*stride, so the invariant's antecedent holds)
      // right where it's needed, rather than leaving the solver to find
      // it unprompted.
      assert own == strided_sum(orig, tid, 2 * stride, 8 / (2 * stride))

      exhale true
      inhale acc(cells[tid + stride].val)
      // The acquire grants PERMISSION only -- it says nothing about what
      // VALUE is there. That value fact comes from the exact same
      // invariant this method already maintains, instantiated at thread
      // (tid+stride) instead of tid: every thread runs this identical
      // proof, so by symmetry thread (tid+stride) maintains the same
      // strided-sum formula for its own cell. This is the value-level
      // analogue of the permission acquire -- justified the same way
      // (by the N-thread symmetry argument), not a new kind of trust.
      inhale cells[tid + stride].val == strided_sum(orig, tid + stride, 2 * stride, 8 / (2 * stride))
      var partner: Int := cells[tid + stride].val
      cells[tid].val := own + partner
      exhale acc(cells[tid + stride].val)
      inhale true

      merge_lemma(orig, tid, stride, 8 / (2 * stride))
      // merge_lemma's postcondition now gives exactly:
      //   own + partner == strided_sum(orig, tid, stride, 2 * (8 / (2*stride)))
      // i.e. cells[tid].val == that -- but the NEXT invariant check names
      // it via (nextstride == 0 ? 1 : 2*nextstride) / 8-over-that, not
      // literally "stride" and "2*(8/(2*stride))" -- connect the two
      // arithmetic forms explicitly, for both parities stride can have
      // here (4, 2 -- even, halving exactly; 1 -- the loop's last round).
      var next_stride: Int := stride / 2
      assert (next_stride == 0 ? 1 : 2 * next_stride) == stride
      assert 8 / (next_stride == 0 ? 1 : 2 * next_stride) == 2 * (8 / (2 * stride))
    }
    stride := stride / 2
  }
}
